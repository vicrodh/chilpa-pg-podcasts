#!/usr/bin/env python3
"""Build a portable WASM plugin in <out>/<plugin id>."""
import hashlib
import json
import pathlib
import shutil
import subprocess
import sys

if len(sys.argv) != 3:
    raise SystemExit("usage: build-plugin <crate dir> <out dir>")
crate = pathlib.Path(sys.argv[1]).resolve()
out = pathlib.Path(sys.argv[2])
manifest = crate / "manifest.json"
identity = json.loads(manifest.read_text())["id"]
metadata = json.loads(subprocess.check_output([
    "cargo", "metadata", "--no-deps", "--format-version", "1", "--manifest-path", str(crate / "Cargo.toml")]))
name = next(package["name"] for package in metadata["packages"]
            if pathlib.Path(package["manifest_path"]).resolve() == crate / "Cargo.toml")
subprocess.run(["cargo", "build", "--manifest-path", str(crate / "Cargo.toml"),
                "-p", name, "--lib", "--release", "--target", "wasm32-unknown-unknown"], check=True)
wasm = pathlib.Path(metadata["target_directory"]) / "wasm32-unknown-unknown" / "release" / f"{name.replace('-', '_')}.wasm"
folder = out / identity
folder.mkdir(parents=True, exist_ok=True)
shutil.copy2(wasm, folder / "plugin.wasm")
shutil.copy2(manifest, folder / "manifest.json")
artifact = folder / "plugin.wasm"
print(f"build-plugin: {artifact} {artifact.stat().st_size} bytes")
print(hashlib.sha256(artifact.read_bytes()).hexdigest(), artifact)
